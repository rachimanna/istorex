# ─── iStoreX production environment (example — NO real secrets here) ───
# Copy to .env on the server:  cp .env.example .env  and fill in the values.

# Public HTTPS address of the site. MUST be https:// in production:
# iOS refuses itms-services manifests and IPA downloads over plain HTTP.
APP_URL=https://istorex.example.com
# Domain for Caddy's automatic Let's Encrypt certificate (docker-compose.prod.yml)
DOMAIN=istorex.example.com
ACME_EMAIL=admin@example.com

# ─── PostgreSQL ───
POSTGRES_USER=istorex
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=istorex
DATABASE_URL=postgresql://istorex:change-me-long-random@db:5432/istorex?schema=public

# ─── Secrets ───
# 32+ random bytes, e.g.: openssl rand -hex 32
SESSION_SECRET=
# Used to call /api/cron/check-availability from cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ─── Object storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO) ───
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Private bucket for IPA files (served only through short-lived presigned URLs)
S3_BUCKET_IPA=istorex-ipa
# Bucket for icons and screenshots
S3_BUCKET_MEDIA=istorex-media
# Optional: public base URL for the media bucket (R2 custom domain / CDN).
# If empty, media is proxied through /media/* on the app server.
S3_PUBLIC_BASE_URL=
# Bucket for database backups (should be private; can be the same account)
S3_BUCKET_BACKUP=istorex-backup
BACKUP_RETENTION_DAYS=14

# ─── Limits (cost control) ───
MAX_IPA_SIZE_MB=2048
MAX_IMAGE_SIZE_MB=8
# Install/download attempts allowed per IP per 24h
DOWNLOADS_PER_IP_PER_DAY=30
# Hard monthly egress budget for hosted IPAs; hosted installs are paused when reached. 0 = unlimited
MONTHLY_EGRESS_BUDGET_GB=500
# Presigned IPA URL lifetime (seconds)
IPA_URL_TTL_SECONDS=900
# Open self-registration for users (true/false)
ALLOW_REGISTRATION=true

# ─── Optional malware scanning via ClamAV (clamd). Empty = disabled ───
CLAMAV_HOST=
CLAMAV_PORT=3310

# ─── Contacts shown on /contact and legal pages ───
CONTACT_EMAIL=support@example.com
ABUSE_EMAIL=abuse@example.com
OPERATOR_NAME=iStoreX
